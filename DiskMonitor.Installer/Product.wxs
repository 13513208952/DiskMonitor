<?xml version="1.0" encoding="UTF-8"?>
<!--
  DiskMonitor MSI Package Definition
  WiX v4 (WiX toolset 7.x)

  FrontendComponents and ServiceComponents are defined in generated fragment files:
    FrontendFiles.wxs  - frontend files in %ProgramFiles%\DiskMonitor\
    ServiceFiles.wxs   - service binary in %ProgramData%\DiskMonitor\service\ (Permanent)

  Build-time variables (passed via -d flags):
    CADll        - path to DiskMonitor.InstallerActions.CA.dll
    LicenseRtf   - path to installer\License.rtf
    ProductVersion - e.g. 1.3.0
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="DiskMonitor"
           Manufacturer="DiskMonitor Project"
           Version="$(var.ProductVersion)"
           UpgradeCode="{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}"
           Language="2052"
           Codepage="936"
           InstallerVersion="500"
           Compressed="yes"
           Scope="perMachine">

    <SummaryInformation Description="DiskMonitor Windows 磁盘 I/O 监控工具" />

    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 DiskMonitor，无法降级。" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ── Properties ───────────────────────────────────────────────────── -->
    <Property Id="REMOVE_SERVICE" Value="0" Secure="yes" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- ── Directories ──────────────────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DiskMonitor" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DISKMONITOR_APPDATA" Name="DiskMonitor">
        <Directory Id="SERVICE_DIR" Name="service" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="DiskMonitor" />
    </StandardDirectory>

    <!-- ── Shortcut component ───────────────────────────────────────────── -->
    <Component Id="ApplicationShortcuts"
               Directory="ApplicationProgramsFolder"
               Guid="{B3C4D5E6-F7A8-9012-BCDE-F12345678901}">
      <Shortcut Id="StartMenuShortcut"
                Name="DiskMonitor"
                Description="Windows 磁盘 I/O 监控工具"
                Target="[INSTALLFOLDER]DiskMonitor.Frontend.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="DesktopShortcut"
                Name="DiskMonitor"
                Description="Windows 磁盘 I/O 监控工具"
                Target="[INSTALLFOLDER]DiskMonitor.Frontend.exe"
                WorkingDirectory="INSTALLFOLDER"
                Directory="DesktopFolder" />
      <RemoveFolder Id="CleanApplicationProgramsFolder"
                    Directory="ApplicationProgramsFolder"
                    On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\DiskMonitor\MSI"
                     Name="ShortcutsInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- ── Custom Action DLL ─────────────────────────────────────────────── -->
    <Binary Id="InstallerActionsCA" SourceFile="$(var.CADll)" />

    <!-- ── Custom Actions ───────────────────────────────────────────────── -->

    <!-- INSTALL: stop + delete existing portable service before installing files -->
    <CustomAction Id="MigratePortableService"
                  BinaryRef="InstallerActionsCA"
                  DllEntry="MigratePortableService"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- INSTALL: register service from ProgramData path after files are installed -->
    <CustomAction Id="RegisterService"
                  BinaryRef="InstallerActionsCA"
                  DllEntry="RegisterService"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- INSTALL: start service after registration -->
    <CustomAction Id="StartService"
                  BinaryRef="InstallerActionsCA"
                  DllEntry="StartService"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- UNINSTALL: show MessageBox asking user whether to also remove the service -->
    <CustomAction Id="AskRemoveService"
                  BinaryRef="InstallerActionsCA"
                  DllEntry="AskRemoveService"
                  Execute="immediate"
                  Return="check" />

    <!-- UNINSTALL: pass REMOVE_SERVICE into deferred action's CustomActionData -->
    <CustomAction Id="SetRemoveServiceData"
                  BinaryRef="InstallerActionsCA"
                  DllEntry="SetRemoveServiceData"
                  Execute="immediate"
                  Return="check" />

    <!-- UNINSTALL: conditionally stop/delete service and clean up ProgramData files -->
    <CustomAction Id="RemoveServiceConditional"
                  BinaryRef="InstallerActionsCA"
                  DllEntry="RemoveServiceConditional"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- ── Execute sequence ──────────────────────────────────────────────── -->
    <InstallExecuteSequence>
      <!-- Install: migrate old service before copying new files -->
      <Custom Action="MigratePortableService"
               Before="InstallFiles"
               Condition="NOT Installed" />

      <!-- Install: register service after files are in place -->
      <Custom Action="RegisterService"
               After="InstallFiles"
               Condition="NOT Installed" />

      <!-- Install: start service -->
      <Custom Action="StartService"
               After="RegisterService"
               Condition="NOT Installed" />

      <!-- Uninstall: pass data into deferred remove action -->
      <Custom Action="SetRemoveServiceData"
               Before="RemoveServiceConditional"
               Condition="REMOVE~=&quot;ALL&quot;" />

      <!-- Uninstall: conditionally remove service + ProgramData files -->
      <Custom Action="RemoveServiceConditional"
               Before="RemoveFiles"
               Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- ── UI sequence ───────────────────────────────────────────────────── -->
    <InstallUISequence>
      <!-- Uninstall: ask user whether to remove service (shows MessageBox) -->
      <Custom Action="AskRemoveService"
               Before="ProgressDlg"
               Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallUISequence>

    <!-- ── UI ────────────────────────────────────────────────────────────── -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- ── Features ─────────────────────────────────────────────────────── -->
    <Feature Id="ProductFeature" Title="DiskMonitor" Level="1">
      <ComponentGroupRef Id="FrontendComponents" />
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentRef Id="ApplicationShortcuts" />
    </Feature>

  </Package>

</Wix>
