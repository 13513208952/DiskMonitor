<Window x:Class="DiskMonitor.Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskMonitor" Height="760" Width="1160"
        MinHeight="600" MinWidth="900"
        Background="{DynamicResource BgBase}"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ═══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BgBorder}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0" LastChildFill="False">

                <!-- Left: logo + title -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="22" Height="22" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="24" Height="24" Fill="{DynamicResource BgBorder}"/>
                            <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18"
                                     Fill="{DynamicResource BgHover}"/>
                            <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                                     Fill="{DynamicResource Accent}"/>
                            <Ellipse Canvas.Left="11" Canvas.Top="11" Width="2" Height="2"
                                     Fill="{DynamicResource AccentLight}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="DiskMonitor"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TxtPrimary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="磁盘 I/O 监控"
                               FontSize="11" Margin="10,0,0,0"
                               Foreground="{DynamicResource TxtMuted}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: status + controls -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                             Fill="{DynamicResource TxtMuted}"
                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TxtStatus" Text="检查中"
                               FontSize="12" Foreground="{DynamicResource TxtSecond}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnStart" Content="启动服务"
                            Style="{StaticResource GreenBtn}"
                            Margin="0,0,8,0" Click="BtnStart_Click"/>
                    <Button x:Name="BtnStop" Content="停止服务"
                            Style="{StaticResource GhostBtn}"
                            Click="BtnStop_Click"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══ Tab Content ══════════════════════════════════════ -->
        <TabControl Grid.Row="1">

            <!-- ── 今日 ──────────────────────────────────────── -->
            <TabItem Header="今日">
                <Grid Background="{DynamicResource BgBase}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="{DynamicResource BgSurface}"
                            BorderBrush="{DynamicResource BgBorder}" BorderThickness="0,0,0,1"
                            Padding="20,10">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" x:Name="TxtTodayDate"
                                       FontSize="12" Foreground="{DynamicResource TxtSecond}"
                                       VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="刷新"
                                    Style="{StaticResource GhostBtn}"
                                    Click="BtnRefresh_Click"/>
                        </DockPanel>
                    </Border>

                    <!-- Stat cards -->
                    <UniformGrid Grid.Row="1" Columns="3" Margin="20,16,20,0">

                        <Border Margin="0,0,8,0" Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BgBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="总读取" FontSize="11"
                                           Foreground="{DynamicResource TxtSecond}"/>
                                <TextBlock x:Name="TxtTotalRead" Text="—"
                                           FontSize="26" FontWeight="Light" Margin="0,6,0,0"
                                           Foreground="{DynamicResource AccentLight}"/>
                                <TextBlock x:Name="TxtTotalReadSub" Text=" "
                                           FontSize="11" Foreground="{DynamicResource TxtMuted}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="4,0" Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BgBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="总写入" FontSize="11"
                                           Foreground="{DynamicResource TxtSecond}"/>
                                <TextBlock x:Name="TxtTotalWrite" Text="—"
                                           FontSize="26" FontWeight="Light" Margin="0,6,0,0"
                                           Foreground="{DynamicResource WriteFg}"/>
                                <TextBlock x:Name="TxtTotalWriteSub" Text=" "
                                           FontSize="11" Foreground="{DynamicResource TxtMuted}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="8,0,0,0" Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BgBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="活跃进程" FontSize="11"
                                           Foreground="{DynamicResource TxtSecond}"/>
                                <TextBlock x:Name="TxtProcCount" Text="—"
                                           FontSize="26" FontWeight="Light" Margin="0,6,0,0"
                                           Foreground="{DynamicResource CountFg}"/>
                                <TextBlock x:Name="TxtProcCountSub" Text=" "
                                           FontSize="11" Foreground="{DynamicResource TxtMuted}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2" x:Name="GridToday" Margin="20,14,20,0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开文件所在目录" Click="MenuOpenLocation_Click"/>
                                <MenuItem Header="复制进程路径"     Click="MenuCopyPath_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}"
                                                Width="*" MinWidth="160"/>
                            <DataGridTextColumn Header="盘符" Binding="{Binding DriveLetter}"
                                                Width="58"/>
                            <DataGridTextColumn Header="卷标" Binding="{Binding VolumeLabel}"
                                                Width="110"/>
                            <DataGridTextColumn Header="磁盘型号" Binding="{Binding DiskModel}"
                                                Width="200"/>
                            <DataGridTextColumn Header="读取" Binding="{Binding ReadDisplay}"
                                                Width="100" SortMemberPath="ReadBytes">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding"             Value="0,0,10,0"/>
                                        <Setter Property="Foreground"          Value="{DynamicResource AccentLight}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="写入" Binding="{Binding WriteDisplay}"
                                                Width="100" SortMemberPath="WriteBytes">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding"             Value="0,0,10,0"/>
                                        <Setter Property="Foreground"          Value="{DynamicResource WriteFg}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="合计" Binding="{Binding TotalDisplay}"
                                                Width="110" SortMemberPath="TotalBytes">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding"             Value="0,0,14,0"/>
                                        <Setter Property="FontWeight"          Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>

            <!-- ── 历史 ──────────────────────────────────────── -->
            <TabItem Header="历史">
                <Grid Background="{DynamicResource BgBase}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="{DynamicResource BgSurface}"
                            BorderBrush="{DynamicResource BgBorder}" BorderThickness="0,0,0,1"
                            Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="从" VerticalAlignment="Center" Margin="0,0,8,0"
                                       FontSize="12" Foreground="{DynamicResource TxtSecond}"/>
                            <DatePicker x:Name="DpFrom" Width="130" Height="32"
                                        SelectedDateFormat="Short"/>
                            <TextBlock Text="到" VerticalAlignment="Center" Margin="12,0,8,0"
                                       FontSize="12" Foreground="{DynamicResource TxtSecond}"/>
                            <DatePicker x:Name="DpTo" Width="130" Height="32"
                                        SelectedDateFormat="Short"/>
                            <Button Content="查询" Style="{StaticResource PrimaryBtn}"
                                    Margin="12,0,0,0" Click="BtnQuery_Click"/>
                            <Button Content="导出 CSV" Style="{StaticResource GhostBtn}"
                                    Margin="8,0,0,0" Click="BtnExportHistory_Click"/>
                            <TextBlock x:Name="TxtHistoryCount" Text=""
                                       VerticalAlignment="Center" Margin="16,0,0,0"
                                       FontSize="11" Foreground="{DynamicResource TxtMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="GridHistory"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开文件所在目录" Click="MenuOpenLocation_Click"/>
                                <MenuItem Header="复制进程路径"     Click="MenuCopyPath_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding Date}" Width="90"/>
                            <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}"
                                                Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="盘符" Binding="{Binding DriveLetter}"
                                                Width="58"/>
                            <DataGridTextColumn Header="卷标" Binding="{Binding VolumeLabel}"
                                                Width="110"/>
                            <DataGridTextColumn Header="磁盘型号" Binding="{Binding DiskModel}"
                                                Width="180"/>
                            <DataGridTextColumn Header="读取" Binding="{Binding ReadDisplay}"
                                                Width="100" SortMemberPath="ReadBytes">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding"             Value="0,0,10,0"/>
                                        <Setter Property="Foreground"          Value="{DynamicResource AccentLight}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="写入" Binding="{Binding WriteDisplay}"
                                                Width="100" SortMemberPath="WriteBytes">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding"             Value="0,0,10,0"/>
                                        <Setter Property="Foreground"          Value="{DynamicResource WriteFg}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="合计" Binding="{Binding TotalDisplay}"
                                                Width="110" SortMemberPath="TotalBytes">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding"             Value="0,0,14,0"/>
                                        <Setter Property="FontWeight"          Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </TabItem>

            <!-- ── 设置 ──────────────────────────────────────── -->
            <TabItem Header="设置">
                <ScrollViewer Background="{DynamicResource BgBase}"
                               VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,28" MaxWidth="700">

                        <!-- Theme section -->
                        <TextBlock Text="外观主题" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BgBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="配色方案" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="切换后立即生效，下次启动自动恢复"
                                               FontSize="11" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TxtSecond}"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbTheme" Grid.Column="1"
                                          Width="210" VerticalAlignment="Center"
                                          SelectionChanged="CmbTheme_SelectionChanged">
                                    <ComboBoxItem Content="Darkly — 暗色 · 蓝"   Tag="Darkly"/>
                                    <ComboBoxItem Content="Superhero — 暗色 · 橙" Tag="Superhero"/>
                                    <ComboBoxItem Content="Cosmo — 亮色 · 蓝"    Tag="Cosmo"/>
                                    <ComboBoxItem Content="Flatly — 亮色 · 翠"   Tag="Flatly"/>
                                    <ComboBoxItem Content="Journal — 暖白 · 红"  Tag="Journal"/>
                                    <ComboBoxItem Content="Litera — 纯净 · 蓝"   Tag="Litera"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Service section -->
                        <TextBlock Text="服务管理" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,24,0,12"/>
                        <Border Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BgBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="20,18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="DiskMonitor Service"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtServiceDetail"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TxtSecond}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button x:Name="BtnInstall" Content="安装服务"
                                                Style="{StaticResource PrimaryBtn}"
                                                Margin="0,0,8,0" Click="BtnInstall_Click"/>
                                        <Button x:Name="BtnUninstall" Content="卸载服务"
                                                Style="{StaticResource GhostBtn}"
                                                Click="BtnUninstall_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Rectangle Height="1" Fill="{DynamicResource BgBorder}"
                                           Margin="0,14"/>
                                <TextBlock Text="数据库路径" FontSize="11"
                                           Foreground="{DynamicResource TxtSecond}"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtDbPath" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Export section -->
                        <TextBlock Text="数据导出" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,24,0,12"/>
                        <Border Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BgBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="导出全部历史为 CSV"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TxtSecond}"
                                               Text="将数据库中所有 I/O 记录导出为逗号分隔文件"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="选择路径并导出"
                                        Style="{StaticResource GhostBtn}"
                                        VerticalAlignment="Center"
                                        Click="BtnExportAll_Click"/>
                            </Grid>
                        </Border>

                        <!-- Danger zone — improved visual -->
                        <TextBlock Text="危险区域" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,24,0,12"
                                   Foreground="{DynamicResource DangerTitleFg}"/>
                        <Border Background="{DynamicResource DangerBg}"
                                BorderBrush="{DynamicResource DangerBorder}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <!-- Red left accent bar -->
                                <Border Width="4" HorizontalAlignment="Left"
                                        Background="{DynamicResource DangerBorder}"
                                        CornerRadius="8,0,0,8"/>
                                <Grid Margin="20,18,20,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠  " FontSize="13"
                                                       Foreground="{DynamicResource DangerTitleFg}"/>
                                            <TextBlock Text="完全卸载" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DangerTitleFg}"/>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Margin="20,4,0,0"
                                                   Foreground="{DynamicResource DangerDescFg}"
                                                   TextWrapping="Wrap"
                                                   Text="停止并注销服务，删除可执行文件。可选择保留历史数据库。"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="完全卸载..."
                                            Style="{StaticResource DangerBtn}"
                                            VerticalAlignment="Center"
                                            Click="BtnFullUninstall_Click"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,28,0,0" FontSize="11"
                                   Foreground="{DynamicResource TxtMuted}"
                                   Text="DiskMonitor — 仅使用公开 Windows API · 无内核驱动 · 无进程注入 · 无网络上传"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ══ Status Bar ════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BgBorder}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TxtMuted}">
                    <Run Text="上次刷新: "/>
                    <Run x:Name="RunLastRefresh" Text="—"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Margin="20,0,0,0" FontSize="11"
                           Foreground="{DynamicResource TxtMuted}">
                    <Run Text="今日记录: "/>
                    <Run x:Name="RunRecordCount" Text="—"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" x:Name="TxtHeartbeat"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TxtMuted}"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
